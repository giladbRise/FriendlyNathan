# Database Configuration
DATABASE_URL="postgresql://postgres:password@localhost:5432/n8n_workflow_builder"

# JWT Authentication
JWT_SECRET="change-this-to-a-secure-random-string-minimum-32-characters"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# Google Gemini API
GEMINI_API_KEY="your-google-gemini-api-key-here"
GEMINI_MODEL="gemini-3-flash-preview"

# n8n Configuration (for testing/development)
N8N_API_URL="https://your-n8n-instance.com"
N8N_API_KEY="your-n8n-api-key-here"

# Server Configuration
PORT=3000
NODE_ENV=development

# Encryption (for storing API keys)
# Generate a random 32-character key: openssl rand -hex 16
ENCRYPTION_KEY="your-32-character-encryption-key-here"

# CORS Configuration
FRONTEND_URL="http://localhost:5173"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Workflow Generation Rate Limit
WORKFLOW_RATE_LIMIT_WINDOW_MS=3600000
WORKFLOW_RATE_LIMIT_MAX=20

# Node Cache TTL (in seconds)
NODE_CACHE_TTL=3600

# Session Configuration
SESSION_TIMEOUT_MS=86400000
