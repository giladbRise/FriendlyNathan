    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.6.1",
    "zod": "^3.22.4",
    "@google/generative-ai": "^0.1.3",
    "n8n-mcp": "^1.0.0",
    "axios": "^1.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
